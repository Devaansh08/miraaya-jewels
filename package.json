{
  "name": "miraaya-jewels",
  "version": "1.0.0",
  "private": true,
  "description": "Miraaya Jewels — Luxury E-Commerce Platform",
  "scripts": {
    "dev": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"yellow.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "start": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"yellow.bold,cyan.bold\" \"npm run server\" \"npm run client\"",
    "server": "npm run start --prefix backend",
    "client": "npm run dev --prefix frontend",
    "build": "cd frontend && npm install && npm run build"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.9.4",
    "nodemailer": "^6.9.13"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
